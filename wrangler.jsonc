// Cloudflare Worker for the online game (M7): game files + API + world servers.
// Deploy: bunx wrangler deploy (CI does it when the secrets are set, see .github/workflows/ci.yml).
{
  "name": "bruchlandung",
  "main": "server/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "LobbyDO" },
      { "name": "ROOM", "class_name": "WorldRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LobbyDO", "WorldRoom"] }],
  "ai": { "binding": "AI" },
  "vars": { "MODERATION": "ai" }
}
