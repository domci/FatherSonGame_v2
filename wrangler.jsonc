// Cloudflare Worker for the online game (M7): game files + API + world servers.
// Deploy: bunx wrangler deploy (CI does it when the secrets are set, see .github/workflows/ci.yml).
{
  "name": "bruchlandung",
  "main": "server/worker.ts",
  "workers_dev": true,
  "routes": [{ "pattern": "crashlanded.dom-builds.com", "custom_domain": true }],
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "LobbyDO" },
      { "name": "ROOM", "class_name": "WorldRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LobbyDO", "WorldRoom"] }],
  "ai": { "binding": "AI" },
  // Against bots and costs (ADR 0012). Counted per Cloudflare location; the address is not stored.
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "71001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_NEW", "namespace_id": "71002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "71003", "simple": { "limit": 200, "period": 60 } }
  ],
  "vars": { "MODERATION": "ai" }
}
